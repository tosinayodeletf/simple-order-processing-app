pipeline {
    agent any

    stages {

        stage('Install Maven') {
            steps {
                sh '''
                    echo "Installing Maven 3.9.12"

                    sudo rm -rf /opt/maven
                    cd /tmp

                    echo "Downloading Maven..."
                    wget https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.12/apache-maven-3.9.12-bin.tar.gz

                    echo "Extracting Maven..."
                    tar -xzf apache-maven-3.9.12-bin.tar.gz

                    echo "Moving Maven to /opt/maven"
                    sudo mv apache-maven-3.9.12 /opt/maven
                    sudo chown -R jenkins:jenkins /opt/maven

                    echo "Maven Installed:"
                    /opt/maven/bin/mvn -version
                '''
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/tosinayodeletf/simple-order-processing-app.git'
            }
        }

        stage('Build with Maven') {
            steps {
                sh '/opt/maven/bin/mvn clean package -Dmaven.test.failure.ignore=true'
            }
        }
    }

    post {
        success {
            echo "Build Successful — Archiving Artifacts"
            junit '**/target/surefire-reports/TEST-*.xml'
            archiveArtifacts 'target/*.jar'
        }
        failure {
            echo "Build Failed"
        }
    }
}

    
